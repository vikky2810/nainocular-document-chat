# Server
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# MongoDB (local, started with `docker compose up -d` from the repo root)
MONGODB_URI=mongodb://localhost:27017/nainocular?directConnection=true
# "mongodb" = $vectorSearch (needs the mongodb-atlas-local image or Atlas)
# "memory"  = cosine similarity in Node (works with any plain mongod)
VECTOR_SEARCH=mongodb

# OpenRouter (used for both the LLM and embeddings)
# Free models need "free model training" allowed at https://openrouter.ai/settings/privacy,
# otherwise OpenRouter returns "No endpoints found matching your data policy".
OPENROUTER_API_KEY=
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Tried in order when LLM_MODEL is rate-limited (free models often are)
LLM_FALLBACK_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,google/gemma-4-31b-it:free
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
# Optional. Detected automatically from the embedding model when left empty.
EMBEDDING_DIMENSIONS=

# RAG tuning
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=5
MIN_SIMILARITY=0.15

# Uploads
MAX_FILE_SIZE_MB=10
